# Local docker environment. Copy to .env (gitignored) and fill in your values:
#   cp .env.example .env
# Everything here is passed into the container; the *_DIR variables are also
# used by containers/start_docker.sh to set up the volume mounts.

# --- Secrets (never commit these) ---
WANDB_API_KEY=

# --- Host paths to mount (leave empty / remove to skip a mount) ---
# Mounted at /datasets (expects nuscenes/, argoverse2/, occ3d-nuscenes/, ...).
DATASETS_DIR=
# Mounted at /outputs (experiments, checkpoints, DINOv3 backbone ckpts under ckpts/).
OUTPUTS_DIR=
# Pseudo-label npz roots from generate_pseudo_labels, mounted at
# /datasets/pseudo_labels/{semantics,depth}.
PSEUDO_SEMANTICS_DIR=
PSEUDO_DEPTH_DIR=
