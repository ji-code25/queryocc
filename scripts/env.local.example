# Copy to scripts/env.local.sh on the cluster. That file is git-ignored.
# Grounded-SAM and Metric3D may live in unrelated directories; bind each stream
# directly rather than copying them into the QueryOcc project.

PROJECT_ROOT=/proj/agp/projects/queryocc
CONTAINER=/proj/agp/containers/queryocc_20261109.sif
OUTPUT_DIR=/proj/agp/projects/queryocc/output

DINOV3_CKPT_DIR=/path/to/dinov3/checkpoints
PSEUDOSEG_ROOT=/path/to/nuscenes/pseudoseg

NUSC_DATASET_ROOT=/proj/adas-data/data/nuscenes
NUSC_PANOPTIC=/proj/adas-data/data/nuscenes/panoptic
NUSC_LIDARSEG=/proj/adas-data/data/nuscenes/lidarseg
NUSC_OCC3D_DATASET_ROOT=/path/to/occ3d-nuscenes
NUSC_INFOS_ROOT=/proj/adas-data/data/nuscenes/infos
NUSC_MISSING_POINTS_DIR=/path/to/nuscenes_missing_points_cache

# Canonical materialized QueryOcc layout. Smoke preparation and the one-time
# full conversion share this root, so samples converted for smoke are reused.
QUERYOCC_CONVERTED_ROOT=/proj/adas-data/data/nuscenes/queryocc_nuscenes/grounded_sam1_gfo_v2_iou095_agenticrefiner_v4.3
PSEUDO_SEMANTICS_ROOT=$QUERYOCC_CONVERTED_ROOT/semantics
PSEUDO_DEPTH_ROOT=$QUERYOCC_CONVERTED_ROOT/depth

# Or use both legacy variables for the flat DragonBall/GaussianFlowOcc labels
# plus per-sample Metric3D .npy files. Smoke preparation converts them into the
# QueryOcc layout and remaps legacy sky label 17 to the collision-free label 18.
# LEGACY_PSEUDO_SEMANTICS_ROOT=/proj/adas-data/data/nuscenes/nusc_image_masks/grounded_sam1_gfo_v2_iou095_agenticrefiner_v4.3
# LEGACY_PSEUDO_DEPTH_ROOT=/proj/adas-data/data/nuscenes/gaussianflowocc_nuscenes/metric_3d_nusc

AV2_DATASET_ROOT=/path/to/argoverse2
AV2_MISSING_POINTS_DIR=/path/to/av2_missing_points_cache

QUERYOCC_SMOKE_ROOT=/proj/adas-data/data/nuscenes/queryocc_nuscenes/experiments/queryocc-nusc-smoke100
